# 环境变量模板：**只登记键名与用途，不写真实值**。
# 真实值放 .env.local（已在 .gitignore 中）。变量的登记表见《技术栈说明》§4.3。

# SQLite 数据库文件的绝对路径。
# 本地不设：代码回退到项目下的 data/nexus-os.db（该目录不入库）。
# 线上必设——standalone 产物的工作目录是发布目录，相对路径会落到别的地方：
#   DATABASE_PATH=/opt/nexus-os/shared/data/nexus-os.db
DATABASE_PATH=

# 会话 cookie 是否只在 HTTPS 下传输。
# 本地是 HTTP，**必须保持 false（或不设）**：一旦为 true，浏览器会直接丢弃这个 cookie，
# 表现为「登录成功，一刷新就掉线」，而且哪里都不报错——这是本项目踩过的坑。
# 线上 HTTPS 已上线，shared/.env.production 里已是 true（2026-10-29 实测核对）。
SESSION_COOKIE_SECURE=false

# 用户 API Key 的加密主密钥（AES-256-GCM，32 字节；base64 或 64 位 hex 都认）。
# 用途：把每个用户在「设置 → API 密钥」里填的 Key 加密后存进 user_secrets。
# 这是全站**唯一**的全局密钥——站点不再统一持有任何人的模型 / 工具 Key。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 注意：它一旦更换，库里所有密文都解不开，所有人得重新填一遍（有意为之，不做迁移）。
ENCRYPTION_KEY=

# ⚠️ 以下两项**已废弃**：模型与工具的 Key 属于每个用户，在设置页各自填
# （《功能/用户密钥》）。代码已不再读取这两个变量，保留键名只为迁移期对照——
# 本人在设置页填好之后，可以把这两行一起删掉。
DEEPSEEK_API_KEY=
TIKHUB_API_KEY=
