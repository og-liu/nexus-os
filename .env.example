# ============================================================
# Nexus OS 环境变量模板
# 使用方法：复制本文件为 .env.local，填入真实值。
# .env.local 已被 .gitignore 忽略，不会提交到 Git。
# ============================================================

# ─── DeepSeek 大模型（必填）────────────────────────────────
# 用途：Agent 对话的主力模型
# 获取：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# 使用的模型（可选，默认 deepseek-v4-flash）
DEEPSEEK_MODEL=deepseek-v4-flash

# ─── OpenRouter（可选）─────────────────────────────────────
# 用途：备选模型通道，支持 DeepSeek 不提供的模型
# 获取：https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ─── Tavily 联网搜索（用搜索功能时必填）────────────────────
# 用途：web_search 工具调用 Tavily API 搜索互联网
# 免费额度：1000 次/月，无需信用卡
# 获取：https://tavily.com → Dashboard → API Keys
TAVILY_API_KEY=

# 搜索供应商（可选，默认 tavily）
# SEARCH_PROVIDER=tavily
